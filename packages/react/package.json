{
  "name": "pk-validators-react",
  "version": "1.0.0",
  "description": "React hooks, masked input components, and Zod/react-hook-form resolvers for Pakistani CNIC, phone, and passport validation. One install — no separate core/resolvers packages required.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers/index.mjs",
      "require": "./dist/resolvers/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "resolvers": ["dist/resolvers/index.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/resolvers/index.ts --format cjs,esm --dts --external react",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": ["pakistan", "cnic", "phone", "passport", "react", "validation", "input", "zod", "react-hook-form"],
  "author": {
    "name": "Ahmad Awais",
    "url": "https://github.com/itsahmadawais"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsahmadawais/pk-validators-react.git",
    "directory": "packages/react"
  },
  "homepage": "https://pk-validators-react.vercel.app",
  "bugs": {
    "url": "https://github.com/itsahmadawais/pk-validators-react/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^3.23.0",
    "react-hook-form": "^7.53.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true },
    "react-hook-form": { "optional": true }
  },
  "dependencies": {
    "@pk-validators/core": "^1.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/blocks": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "storybook": "^8.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  }
}
